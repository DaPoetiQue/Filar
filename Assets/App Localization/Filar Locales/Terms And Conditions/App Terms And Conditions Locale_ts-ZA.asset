  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: App Terms And Conditions Locale_ts-ZA
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ts-ZA
  m_SharedData: {fileID: 11400000, guid: 7d6869d444a2fe14d815808046a89f61, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 51673616384
    m_Localized: 'Ku pfuxetiwa ko hetelela: August 04, 2023'
    m_Metadata:
      m_Items: []
  - m_Id: 25173604225024
    m_Localized: Hi kombela u hlaya milawu ni swipimelo leswi hi vukheta u nga si
      tirhisa Vukorhokeri Bya Hina.
    m_Metadata:
      m_Items: []
  - m_Id: 27014354227200
    m_Localized: Nhlamuselo Na Tinhlamuselo
    m_Metadata:
      m_Items: []
  - m_Id: 28161638977536
    m_Localized: Ku Hlamusela
    m_Metadata:
      m_Items: []
  - m_Id: 28515575320576
    m_Localized: "Marito lawa letere ro sungula ri tsariweke hi maletere lamakulu
      ya na tinhlamuselo leti hlamuseriweke ehansi ka swiyimo leswi landzelaka. Tinhlamuselo
      leti landzelaka ti ta va na nhlamuselo yo fana ku nga langutiwi leswaku ti
      humelela hi vun\u2019we kumbe hi vunyingi."
    m_Metadata:
      m_Items: []
  - m_Id: 28728805347328
    m_Localized: Tinhlamuselo
    m_Metadata:
      m_Items: []
  - m_Id: 28944136720384
    m_Localized: 'Hi swikongomelo swa Mimpimanyeto na Swipimelo leswi:'
    m_Metadata:
      m_Items: []
  - m_Id: 43022611697664
    m_Localized: Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 43201700089856
    m_Localized: Xitirhisiwa swi vula nongonoko wa software lowu nyikiweke hi Khamphani
      lowu dawunilodiweke hi Wena eka xitirhisiwa xihi kumbe xihi xa elektroniki,
      lexi vuriwaka Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 43451110182912
    m_Localized: Vhengele ra Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 43698783834112
    m_Localized: Vhengele ra Switirhisiwa swi vula vukorhokeri bya ku hangalasiwa
      ka xidijitali lebyi fambisiwaka no tumbuluxiwa hi Apple Inc. (Apple App Store)
      kumbe Google Inc. (Google Play Store) laha Xitirhisiwa xi dawunilodiweke eka
      xona.
    m_Metadata:
      m_Items: []
  - m_Id: 63294500818944
    m_Localized: Xihlanganisi Xa Vuxaka
    m_Metadata:
      m_Items: []
  - m_Id: 63661905072128
    m_Localized: Xihlanganisi swi vula bindzu leri lawulaka, leri lawuriwaka hi kumbe
      leri nga ehansi ka vulawuri lebyi fanaka na vandla, laha "vulawuri" swi vulaka
      vun'wini bya 50% kumbe ku tlula ya swiave, ntswalo wa xiave kumbe tisekhurithi
      tin'wana leti nga na mfanelo yo vhotela ku hlawuriwa ka vakongomisi kumbe vulawuri
      byin'wana.
    m_Metadata:
      m_Items: []
  - m_Id: 63872039702528
    m_Localized: Tiko
    m_Metadata:
      m_Items: []
  - m_Id: 63910203674624
    m_Localized: 'Tiko ri kombetela eka: Afrika-Dzonga'
    m_Metadata:
      m_Items: []
  - m_Id: 64172515446784
    m_Localized: Khamphani
    m_Metadata:
      m_Items: []
  - m_Id: 64238563151872
    m_Localized: Khamphani (leyi vuriwaka "Khamphani", "Hina", "Hina" kumbe "Hina"
      eka Ntwanano lowu) yi kombetela eka Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 64358486691840
    m_Localized: Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 64397112037376
    m_Localized: "Xitirhisiwa swi vula xitirhisiwa xin\u2019wana na xin\u2019wana
      lexi nga nghenaka eka Vukorhokeri ku fana na khompyuta, selfoni kumbe thebulete
      ya xidijitali."
    m_Metadata:
      m_Items: []
  - m_Id: 64548060844032
    m_Localized: Vukorhokeri
    m_Metadata:
      m_Items: []
  - m_Id: 64580189212672
    m_Localized: Vukorhokeri byi kombetela eka Xikombelo.
    m_Metadata:
      m_Items: []
  - m_Id: 77746675699712
    m_Localized: Mimpimanyeto na Swipimelo (leswi tlhelaka swi vuriwa "Mimpimanyeto")
      swi vula Mimpimanyeto na Swipimelo leswi leswi vumbeke ntwanano hinkwawo exikarhi
      ka Wena na Khamphani mayelana na ku tirhisiwa ka Vukorhokeri. Ntwanano lowu
      wa Mimpimanyeto na Swipimelo wu tumbuluxiwile hi ku pfuniwa hi Muendli wa Mimpimanyeto
      na Swipimelo.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
