  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: App Terms And Conditions Locale_ts-ZA
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ts-ZA
  m_SharedData: {fileID: 11400000, guid: 7d6869d444a2fe14d815808046a89f61, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 51673616384
    m_Localized: 'Ku pfuxetiwa ko hetelela: August 04, 2023'
    m_Metadata:
      m_Items: []
  - m_Id: 25173604225024
    m_Localized: Hi kombela u hlaya milawu ni swipimelo leswi hi vukheta u nga si
      tirhisa Vukorhokeri Bya Hina.
    m_Metadata:
      m_Items: []
  - m_Id: 27014354227200
    m_Localized: Nhlamuselo Na Tinhlamuselo
    m_Metadata:
      m_Items: []
  - m_Id: 28161638977536
    m_Localized: Ku Hlamusela
    m_Metadata:
      m_Items: []
  - m_Id: 28515575320576
    m_Localized: "Marito lawa letere ro sungula ri tsariweke hi maletere lamakulu
      ya na tinhlamuselo leti hlamuseriweke ehansi ka swiyimo leswi landzelaka. Tinhlamuselo
      leti landzelaka ti ta va na nhlamuselo yo fana ku nga langutiwi leswaku ti
      humelela hi vun\u2019we kumbe hi vunyingi."
    m_Metadata:
      m_Items: []
  - m_Id: 28728805347328
    m_Localized: Tinhlamuselo
    m_Metadata:
      m_Items: []
  - m_Id: 28944136720384
    m_Localized: 'Hi swikongomelo swa Mimpimanyeto na Swipimelo leswi:'
    m_Metadata:
      m_Items: []
  - m_Id: 43022611697664
    m_Localized: Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 43201700089856
    m_Localized: Xitirhisiwa swi vula nongonoko wa software lowu nyikiweke hi Khamphani
      lowu dawunilodiweke hi Wena eka xitirhisiwa xihi kumbe xihi xa elektroniki,
      lexi vuriwaka Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 43451110182912
    m_Localized: Vhengele ra Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 43698783834112
    m_Localized: Vhengele ra Switirhisiwa swi vula vukorhokeri bya ku hangalasiwa
      ka xidijitali lebyi fambisiwaka no tumbuluxiwa hi Apple Inc. (Apple App Store)
      kumbe Google Inc. (Google Play Store) laha Xitirhisiwa xi dawunilodiweke eka
      xona.
    m_Metadata:
      m_Items: []
  - m_Id: 63294500818944
    m_Localized: Xihlanganisi Xa Vuxaka
    m_Metadata:
      m_Items: []
  - m_Id: 63661905072128
    m_Localized: Xihlanganisi swi vula bindzu leri lawulaka, leri lawuriwaka hi kumbe
      leri nga ehansi ka vulawuri lebyi fanaka na vandla, laha "vulawuri" swi vulaka
      vun'wini bya 50% kumbe ku tlula ya swiave, ntswalo wa xiave kumbe tisekhurithi
      tin'wana leti nga na mfanelo yo vhotela ku hlawuriwa ka vakongomisi kumbe vulawuri
      byin'wana.
    m_Metadata:
      m_Items: []
  - m_Id: 63872039702528
    m_Localized: Tiko
    m_Metadata:
      m_Items: []
  - m_Id: 63910203674624
    m_Localized: 'Tiko ri kombetela eka: Afrika-Dzonga'
    m_Metadata:
      m_Items: []
  - m_Id: 64172515446784
    m_Localized: Khamphani
    m_Metadata:
      m_Items: []
  - m_Id: 64238563151872
    m_Localized: Khamphani (leyi vuriwaka "Khamphani", "Hina", "Hina" kumbe "Hina"
      eka Ntwanano lowu) yi kombetela eka Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 64358486691840
    m_Localized: Xitirhisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 64397112037376
    m_Localized: "Xitirhisiwa swi vula xitirhisiwa xin\u2019wana na xin\u2019wana
      lexi nga nghenaka eka Vukorhokeri ku fana na khompyuta, selfoni kumbe thebulete
      ya xidijitali."
    m_Metadata:
      m_Items: []
  - m_Id: 64548060844032
    m_Localized: Vukorhokeri
    m_Metadata:
      m_Items: []
  - m_Id: 64580189212672
    m_Localized: Vukorhokeri byi kombetela eka Xikombelo.
    m_Metadata:
      m_Items: []
  - m_Id: 77746675699712
    m_Localized: Mimpimanyeto na Swipimelo (leswi tlhelaka swi vuriwa "Mimpimanyeto")
      swi vula Mimpimanyeto na Swipimelo leswi leswi vumbeke ntwanano hinkwawo exikarhi
      ka Wena na Khamphani mayelana na ku tirhisiwa ka Vukorhokeri. Ntwanano lowu
      wa Mimpimanyeto na Swipimelo wu tumbuluxiwile hi ku pfuniwa hi Muendli wa Mimpimanyeto
      na Swipimelo.
    m_Metadata:
      m_Items: []
  - m_Id: 82449031548928
    m_Localized: Vukorhokeri bya swa Vuhangalasi bya Mahungu bya Vanhu bya vanhu
      va vunharhu
    m_Metadata:
      m_Items: []
  - m_Id: 82491586957312
    m_Localized: Vukorhokeri bya Vuhangalasi bya Mahungu bya Vanhu bya Vunharhu swi
      vula vukorhokeri byihi kumbe byihi kumbe swilo leswi nga endzeni (ku katsa
      na datha, mahungu, swikumiwa kumbe vukorhokeri) leswi nyikiwaka hi munhu wa
      vunharhu leswi nga kombisiwaka, swi katsiwile kumbe ku endliwa swi kumeka hi
      Vukorhokeri.
    m_Metadata:
      m_Items: []
  - m_Id: 82586374033408
    m_Localized: Wena
    m_Metadata:
      m_Items: []
  - m_Id: 82629244014592
    m_Localized: "U vula munhu loyi a nghenaka kumbe ku tirhisa Vukorhokeri, kumbe
      khamphani, kumbe nhlangano wun\u2019wana wa nawu lowu munhu yoloye a nghenaka
      kumbe ku tirhisa Vukorhokeri hi ku yimela wona, tanihilaha swi faneleke hakona."
    m_Metadata:
      m_Items: []
  - m_Id: 82837185024000
    m_Localized: Ku khensa
    m_Metadata:
      m_Items: []
  - m_Id: 83335459950592
    m_Localized: Leyi i Mimpimanyeto na Swipimelo leswi lawulaka ku tirhisiwa ka
      Vukorhokeri lebyi na ntwanano lowu tirhaka exikarhi ka Wena na Khamphani. Mimpimanyeto
      na Swipimelo leswi swi veka timfanelo na swiboha swa vatirhisi hinkwavo mayelana
      na ku tirhisiwa ka Vukorhokeri.
    m_Metadata:
      m_Items: []
  - m_Id: 83452556529664
    m_Localized: "Ku fikelela ka wena na ku tirhisa Vukorhokeri swi titshege hi ku
      amukela ka Wena na ku landzelela Mimpimanyeto na Swipimelo leswi. Mimpimanyeto
      na Swipimelo leswi swi tirha eka vaendzi hinkwavo, vatirhisi na van\u2019wana
      lava nghenaka kumbe ku tirhisa Vukorhokeri."
    m_Metadata:
      m_Items: []
  - m_Id: 83485255323648
    m_Localized: Hi ku nghena kumbe ku tirhisa Vukorhokeri U pfumela ku bohiwa hi
      Mimpimanyeto na Swipimelo leswi. Loko U nga pfumelelani na xiphemu xihi kumbe
      xihi xa Mimpimanyeto na Swipimelo leswi kutani U nga ha nghena eka Vukorhokeri.
    m_Metadata:
      m_Items: []
  - m_Id: 83503794147328
    m_Localized: U yimela leswaku u tlula malembe ya 18. Khamphani a yi pfumeleli
      lava nga ehansi ka malembe ya 18 ku tirhisa Vukorhokeri.
    m_Metadata:
      m_Items: []
  - m_Id: 83523813560320
    m_Localized: Ku fikelela ka wena na ku tirhisa Vukorhokeri swi tlhela swi titshege
      hi ku amukela ka Wena na ku landzelela Pholisi ya Vuhlayiseki bya Khamphani.
      Pholisi ya Hina ya Vuhlayiseki yi hlamusela tipholisi na maendlelo ya Hina
      eka nhlengeleto, ku tirhisa na ku paluxa vuxokoxoko bya Wena bya munhu hi xiyexe
      loko U tirhisa Xitirhisiwa kumbe Website naswona yi Ku byela hi timfanelo ta
      Wena ta vuhlayiseki na ndlela leyi nawu wu Ku sirhelelaka ha yona. Hi kombela
      u hlaya Pholisi ya Hina ya Vuhlayiseki hi vukheta u nga si tirhisa Vukorhokeri
      bya Hina.
    m_Metadata:
      m_Items: []
  - m_Id: 83596345659392
    m_Localized: "Swihlanganisi Swa Tiwebsite Tin\u2019wana"
    m_Metadata:
      m_Items: []
  - m_Id: 83704034414592
    m_Localized: "Vukorhokeri bya hina byi nga ha va na swihlanganisi swa tiwebsite
      ta vanhu van\u2019wana kumbe vukorhokeri lebyi nga riki bya Khamphani kumbe
      lebyi nga lawuriwiki."
    m_Metadata:
      m_Items: []
  - m_Id: 83736829677568
    m_Localized: Khamphani a yi na vulawuri eka, naswona a yi teki vutihlamuleri
      eka, leswi nga endzeni, tipholisi ta vuhlayiseki, kumbe maendlelo ya tiwebsite
      kumbe vukorhokeri bya munhu wa vunharhu. U ya emahlweni u amukela no pfumela
      leswaku Khamphani a yi nge vi na vutihlamuleri kumbe vutihlamuleri, hi ku kongoma
      kumbe hi ndlela leyi nga kongomangiki, eka ku onhaka kwihi kumbe kwihi kumbe
      ku lahlekeriwa loku vangiweke kumbe loku ku hehliwaka leswaku ku vangiwe hi
      kumbe ku fambisana na ku tirhisiwa kumbe ku titshega hi swilo swihi kumbe swihi
      swo tano, nhundzu kumbe vukorhokeri lebyi kumekaka eka kumbe hi ku tirhisa
      tiwebsite kumbe vukorhokeri byihi na byihi byo tano.
    m_Metadata:
      m_Items: []
  - m_Id: 83755670491136
    m_Localized: "Hi Ku tsundzuxa swinene ku hlaya milawu na swipimelo na milawu
      ya vuhlayiseki bya tiwebsite kumbe vukorhokeri bya vanhu van\u2019wana lebyi
      U byi endzelaka."
    m_Metadata:
      m_Items: []
  - m_Id: 83948017078272
    m_Localized: Ku herisiwa ka ntirho
    m_Metadata:
      m_Items: []
  - m_Id: 84006988992512
    m_Localized: Hi nga ha herisa kumbe ku yimisa ku nghena ka Wena hi ku hatlisa,
      handle ka xitiviso xa le mahlweni kumbe vutihlamuleri, hikwalaho ka xivangelo
      xihi kumbe xihi, ku katsa na handle ka swipimelo loko U tlula Mimpimanyeto
      na Swipimelo leswi.
    m_Metadata:
      m_Items: []
  - m_Id: 84035392819200
    m_Localized: Loko u herisiwa, Mfanelo ya Wena yo tirhisa Vukorhokeri yi ta hela
      hi ku hatlisa.
    m_Metadata:
      m_Items: []
  - m_Id: 84145598156800
    m_Localized: Ku pimisiwa ka Vutihlamuleri
    m_Metadata:
      m_Items: []
  - m_Id: 84189248278528
    m_Localized: Ku nga tiyiseli ku onhaka kwihi na kwihi loku U nga ku kumaka, vutihlamuleri
      hinkwabyo bya Khamphani na vaphakeri va yona vahi na vahi ehansi ka mphakelo
      wihi kumbe wihi wa Mimpimanyeto leyi na murhi wa Wena wo hlawuleka eka hinkwaswo
      leswi nga laha henhla swi ta pimisiwa eka mali leyi hakeriweke hakunene hi
      Wena hi ku tirhisa Vukorhokeri kumbe 100 USD loko U nga si xava nchumu hi ku
      tirhisa Vukorhokeri.
    m_Metadata:
      m_Items: []
  - m_Id: 84218151227392
    m_Localized: "Ku fikela eka mpimo lowukulu lowu pfumeleriwaka hi nawu lowu tirhaka,
      eka xiyimo xihi kumbe xihi Khamphani kumbe vaphakeri va yona a va nge vi na
      vutihlamuleri bya ku onhaka kwihi kumbe kwihi ko hlawuleka, loku nga languteriwangiki,
      loku nga kongomangiki, kumbe loku nga ta va kona (ku katsa, kambe ku nga ri
      ku helela eka, ku onhaka ka ku lahlekeriwa hi vuyelo, ku lahlekeriwa hi datha
      kumbe mahungu man\u2019wana, ya ku kavanyetiwa ka bindzu, ku vaviseka ka munhu
      hi xiyexe, ku lahlekeriwa hi vuhlayiseki lebyi humaka eka kumbe hi ndlela yihi
      kumbe yihi leyi fambelanaka na ku tirhisiwa kumbe ku tsandzeka ku tirhisa Vukorhokeri,
      sofwere ya munhu wa vunharhu na/kumbe hardware ya munhu wa vunharhu leyi tirhisiwaka
      na Vukorhokeri, kumbe handle ka sweswo mayelana na mphakelo wihi kumbe wihi
      wa Mimpimanyeto leyi), hambiloko Khamphani kumbe muphakeri wihi kumbe wihi
      a tsundzuxiwile hi ku koteka ka ku onhaka koloko naswona hambiloko murhi wu
      tsandzeka eka xikongomelo xa wona xa nkoka."
    m_Metadata:
      m_Items: []
  - m_Id: 84244210438144
    m_Localized: "Mimfumo yin\u2019wana a yi pfumeleli ku hlongoriwa ka tiwaranti
      leti nga kongomisiwa kumbe ku siveriwa ka vutihlamuleri bya ku onhaka loku
      nga humelelangiki kumbe loku nga ta va kona, leswi vulaka leswaku swipimelo
      swin\u2019wana leswi nga laha henhla swi nga ha va swi nga tirhi. Eka swifundzha
      leswi, vutihlamuleri bya vandla rin\u2019wana na rin\u2019wana byi ta pimisiwa
      ku fikela eka mpimo lowukulu lowu pfumeleriwaka hi nawu."
    m_Metadata:
      m_Items: []
  - m_Id: 84308689473536
    m_Localized: '"HI SWONA" na "HI SWONA LESWI YI NGA RI KONA" Ku Tiyimelela'
    m_Metadata:
      m_Items: []
  - m_Id: 84381645197312
    m_Localized: "Vukorhokeri byi nyikiwile eka Wena \"HI LESWI BYI NGA SWONA\" na
      \"HI LESWI YI NGA KUMEKA\" naswona hi swihoxo hinkwaswo na swihoxo handle ka
      waranti ya muxaka wihi na wihi. Ku fikela eka mpimo lowukulu lowu pfumeleriweke
      ehansi ka nawu lowu tirhaka, Khamphani, hi ku yimela yona na hi ku yimela Vahlanganisi
      va yona na vaphakeri va yona na vaphakeri va vona va tilayisense na vaphakeri
      va vukorhokeri, yi ala hi ku kongoma tiwaranti hinkwato, hambi ti kombisiwile,
      leti nga kongomangiki, ta nawu kumbe hi ndlela yin\u2019wana, mayelana na Vukorhokeri,
      ku katsa na tiwaranti hinkwato leti boxiweke ta ku xavisiwa, ku faneleka eka
      xikongomelo xo karhi, xivongo na ku nga tluleriwi, na tiwaranti leti nga humelelaka
      hikwalaho ka ku tirhisana, ndlela ya matirhelo, matirhiselo kumbe maendlelo
      ya bindzu. Handle ko ringaniseriwa eka leswi nga laha henhla, Khamphani a yi
      nyiki waranti kumbe ku tiyimisela, naswona a yi endli vuyimeri bya muxaka wihi
      na wihi bya leswaku Vukorhokeri byi ta fikelela swilaveko swa Wena, byi fikelela
      mbuyelo wihi kumbe wihi lowu kunguhatiweke, byi fambisana kumbe ku tirha na
      software yin\u2019wana na yin\u2019wana, switirhisiwa, tisisiteme kumbe vukorhokeri,
      byi tirha handle ko kavanyetiwa, ku fikelela swipimelo swihi kumbe swihi swa
      matirhelo kumbe ku tshembheka kumbe ku va u nga ri na swihoxo kumbe leswaku
      swihoxo swihi kumbe swihi kumbe swihoxo swi nga lulamisiwa kumbe swi ta lulamisiwa."
    m_Metadata:
      m_Items: []
  - m_Id: 84578211254272
    m_Localized: "Handle ko ringanyeta leswi nga laha henhla, Khamphani kumbe muphakeri
      wihi kumbe wihi wa khamphani a nga endli vuyimeri kumbe waranti ya muxaka wihi
      kumbe wihi, leyi hlamuseriweke kumbe leyi nga kongomangiki: (i) mayelana na
      matirhelo kumbe ku kumeka ka Vukorhokeri, kumbe mahungu, nhundzu, na switirhisiwa
      kumbe swikumiwa ku katsiwile eka swona; (ii) leswaku Vukorhokeri byi ta va
      byi nga kavanyetiwi kumbe byi nga ri na swihoxo; (iii) mayelana na ku pakanisa,
      ku tshembheka, kumbe mali ya mahungu wahi kumbe wahi kumbe nhundzu leyi nyikiweke
      hi ku tirhisa Vukorhokeri; kumbe (iv) leswaku Vukorhokeri, tisevha ta yona,
      swilo leswi nga endzeni, kumbe ti-imeyili leti rhumeriweke ku suka kumbe hi
      ku yimela Khamphani a ti na switsongwatsongwana, swikripti, tihanci ta trojan,
      switsotswana, malware, tibomo ta nkarhi kumbe swiphemu swin\u2019wana leswi
      nga ni khombo."
    m_Metadata:
      m_Items: []
  - m_Id: 84596364201984
    m_Localized: "Mimfumo yin\u2019wana a yi pfumeleli ku hlongoriwa ka tinxaka to
      karhi ta tiwaranti kumbe swipimelo eka timfanelo ta nawu leti tirhaka ta muxavi,
      hikwalaho swin\u2019wana kumbe hinkwaswo swa ku hlongoriwa na swipimelo leswi
      nga laha henhla swi nga ha va swi nga tirhi eka Wena. Kambe eka xiyimo xo tano
      ku hlongoriwa na swipimelo leswi vekiweke eka xiyenge lexi swi ta tirhisiwa
      hi mpimo lowukulu lowu sindzisiwaka ehansi ka nawu lowu tirhaka."
    m_Metadata:
      m_Items: []
  - m_Id: 84687351238656
    m_Localized: Nawu lowu Fumaka
    m_Metadata:
      m_Items: []
  - m_Id: 84728396697600
    m_Localized: "Milawu ya Tiko, ku nga katsiwi milawu ya yona leyi lwisanaka na
      nawu, yi ta lawula Mimpimanyeto leyi na ku tirhisa ka Wena Vukorhokeri. Ku
      tirhisa ka wena Xikombelo ku nga ha tlhela ku va ehansi ka milawu yin\u2019wana
      ya laha kaya, ya mfumo, ya tiko, kumbe ya matiko ya misava."
    m_Metadata:
      m_Items: []
  - m_Id: 84860143980544
    m_Localized: Ntlhantlho wa Minkanerisano
    m_Metadata:
      m_Items: []
  - m_Id: 84912065269760
    m_Localized: Loko U ri na ku vilela kumbe ku kanetana hi Vukorhokeri, U pfumela
      ku rhanga hi ku ringeta ku lulamisa mpfilumpfilu hi ndlela leyi nga riki ya
      xiviri hi ku tihlanganisa na Khamphani.
    m_Metadata:
      m_Items: []
  - m_Id: 84973994168320
    m_Localized: Ku Landzelela Nawu wa United States
    m_Metadata:
      m_Items: []
  - m_Id: 85022312550400
    m_Localized: U yimela no tiyisisa leswaku (i) A wu kumekanga etikweni leri nga
      ehansi ka ku yirisiwa ka mfumo wa United States, kumbe leri hlawuriweke hi
      mfumo wa United States tanihi tiko leri "seketelaka matherorisi", naswona (ii)
      A wu kumekanga leyi xaxametiweke eka nxaxamelo wihi na wihi wa mfumo wa United
      States wa mavandla lama yirisiweke kumbe lama siveleriweke.
    m_Metadata:
      m_Items: []
  - m_Id: 85153434882048
    m_Localized: Ku Hambanisiwa na Ku Tshikiwa
    m_Metadata:
      m_Items: []
  - m_Id: 85247118856192
    m_Localized: Ku hambanisiwa
    m_Metadata:
      m_Items: []
  - m_Id: 85300097110016
    m_Localized: Loko mphakelo wihi kumbe wihi wa Mimpimanyeto leyi wu tekiwa wu
      nga sindzisiwi kumbe lowu nga tirhiki, mphakelo wolowo wu ta cinciwa no hlamuseriwa
      ku hetisisa swikongomelo swa mphakelo wolowo hi mpimo lowukulu lowu kotekaka
      ehansi ka nawu lowu tirhaka naswona swiletelo leswi saleke swi ta ya emahlweni
      swi tirha hi ku hetiseka na ku tirha.
    m_Metadata:
      m_Items: []
  - m_Id: 85441277382656
    m_Localized: Ku tshikiwa ka swilo
    m_Metadata:
      m_Items: []
  - m_Id: 85477595860992
    m_Localized: Handle ka tanihilaha swi nyikiweke hakona laha, ku tsandzeka ku
      tirhisa mfanelo kumbe ku lava ku endliwa ka vutihlamuleri ehansi ka Mimpimanyeto
      leyi a swi nge khumbi vuswikoti bya vandla byo tirhisa mfanelo yoleyo kumbe
      ku lava ku tirha koloko nkarhi wihi kumbe wihi endzhaku ka sweswo naswona ku
      tshikiwa ka ku tlula nawu a ku nge vumbi ku tshikiwa ka ku tlula nawu kwihi
      na kwihi loku landzelaka.
    m_Metadata:
      m_Items: []
  - m_Id: 85554687168512
    m_Localized: Vuhundzuluxeri bya Vuhundzuluxi
    m_Metadata:
      m_Items: []
  - m_Id: 85601160056832
    m_Localized: Mimpimanyeto na Swipimelo leswi swi nga ha va swi hundzuluxeriwe
      loko Hi swi endle swi kumeka eka Wena eka Vukorhokeri bya hina. U pfumela leswaku
      tsalwa ro sungula ra Xinghezi ri ta va kona loko ku ri na mpfilumpfilu.
    m_Metadata:
      m_Items: []
  - m_Id: 85824796151808
    m_Localized: Ku Cinca eka Mimpimanyeto na Swipimelo Leswi
    m_Metadata:
      m_Items: []
  - m_Id: 85891573665792
    m_Localized: Hi na mfanelo, hi ku vona ka Hina ntsena, ku cinca kumbe ku siva
      Mimpimanyeto leyi nkarhi wihi na wihi. Loko ku pfuxetiwa ku ri ka nkoka Hi
      ta endla matshalatshala lama ringaneleke ku nyika xitiviso xa masiku ya kwalomu
      ka 30 ku nga si sungula swipimelo swihi na swihi leswintshwa. Leswi vumbeke
      ku cinca ka swilo leswi vonakaka swi ta bohiwa hi ku vona ka Hina ntsena.
    m_Metadata:
      m_Items: []
  - m_Id: 85924947742720
    m_Localized: Hi ku ya emahlweni u nghena kumbe ku tirhisa Vukorhokeri bya Hina
      endzhaku ka loko ku pfuxetiwa koloko ku sungule ku tirha, U pfumela ku bohiwa
      hi swipimelo leswi pfuxetiweke. Loko U nga pfumelelani na milawu leyintshwa,
      hi ku helela kumbe hi xiphemu, hi kombela u tshika ku tirhisa webusayiti na
      Vukorhokeri.
    m_Metadata:
