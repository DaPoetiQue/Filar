  m_TableData:
  - m_Id: 51673616384
    m_Localized: 'Kugcine ukubuyekezwa: Agasti 04, 2023'
    m_Metadata:
      m_Items: []
  - m_Id: 25173604225024
    m_Localized: Sicela ufunde le migomo nemibandela ngokucophelela ngaphambi kokusebenzisa
      Isevisi Yethu.
    m_Metadata:
      m_Items: []
  - m_Id: 27014354227200
    m_Localized: Ukuhunyushwa Nezincazelo
    m_Metadata:
      m_Items: []
  - m_Id: 28161638977536
    m_Localized: Ukutolika
    m_Metadata:
      m_Items: []
  - m_Id: 28515575320576
    m_Localized: Amagama lapho uhlamvu lokuqala lubhalwe ngosonhlamvukazi anezincazelo
      ezichazwe ngaphansi kwalezi zimo ezilandelayo. Izincazelo ezilandelayo zizoba
      nencazelo efanayo kungakhathaliseki ukuthi zivela ebunyeni noma ngobuningi.
    m_Metadata:
      m_Items: []
  - m_Id: 28728805347328
    m_Localized: Izincazelo
    m_Metadata:
      m_Items: []
  - m_Id: 28944136720384
    m_Localized: 'Ngezinjongo zale Migomo Nemibandela:'
    m_Metadata:
      m_Items: []
  - m_Id: 43022611697664
    m_Localized: I-Application
    m_Metadata:
      m_Items: []
  - m_Id: 43201700089856
    m_Localized: i-Application sisho uhlelo lwesofthiwe oluhlinzekwe yiNkampani olulandwe
      Nguwe kunoma iyiphi idivayisi ye-elekthronikhi, ebizwa ngokuthi i-Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 43451110182912
    m_Localized: Isitolo Sohlelo Lokusebenza
    m_Metadata:
      m_Items: []
  - m_Id: 43698783834112
    m_Localized: Isitolo Sohlelo Lokusebenza sisho isevisi yokusabalalisa yedijithali
      esetshenziswa futhi yathuthukiswa yi-Apple Inc. (Apple App Store) noma i-Google
      Inc. (Google Play Store) lapho Isicelo silandwe khona.
    m_Metadata:
      m_Items: []
