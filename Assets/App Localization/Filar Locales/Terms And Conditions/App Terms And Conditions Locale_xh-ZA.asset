  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: App Terms And Conditions Locale_xh-ZA
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: xh-ZA
  m_SharedData: {fileID: 11400000, guid: 7d6869d444a2fe14d815808046a89f61, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 51673616384
    m_Localized: 'Igqityelwe ukuhlaziya: Agasti 04, 2023'
    m_Metadata:
      m_Items: []
  - m_Id: 25173604225024
    m_Localized: Nceda ufunde le migaqo kunye neemeko ngononophelo ngaphambi kokusebenzisa
      iNkonzo yethu.
    m_Metadata:
      m_Items: []
  - m_Id: 27014354227200
    m_Localized: Ukutolika Kunye neeNkcazo
    m_Metadata:
      m_Items: []
  - m_Id: 28161638977536
    m_Localized: Ukutolikwa
    m_Metadata:
      m_Items: []
  - m_Id: 28515575320576
    m_Localized: Amagama apho unobumba wokuqala abhalwe ngoonobumba abakhulu aneentsingiselo
      ezichazwe phantsi kwezi meko zilandelayo. Ezi nkcazelo zilandelayo ziya kuba
      nentsingiselo efanayo nokuba zivela kwisinye okanye kwisininzi.
    m_Metadata:
      m_Items: []
  - m_Id: 28728805347328
    m_Localized: Iingcaciso
    m_Metadata:
      m_Items: []
  - m_Id: 28944136720384
    m_Localized: 'Ngeenjongo zale Migaqo neMiqathango:'
    m_Metadata:
      m_Items: []
  - m_Id: 43022611697664
    m_Localized: I-Application
    m_Metadata:
      m_Items: []
  - m_Id: 43201700089856
    m_Localized: i-Application sithetha inkqubo yesoftware enikezelwe yiNkampani
      ekhutshelwe nguwe kuso nasiphi na isixhobo sombane esibizwa ngokuba yiFilar.
    m_Metadata:
      m_Items: []
  - m_Id: 43451110182912
    m_Localized: Ivenkile yosetyenziso
    m_Metadata:
      m_Items: []
  - m_Id: 43698783834112
    m_Localized: UGcino lweSicelo luthetha inkonzo yokuhanjiswa kwedijithali eqhutywa
      yaze yaphuhliswa yi-Apple Inc. (iApple App Store) okanye iGoogle Inc. (Google
      Play Store) apho isicelo sikhutshelwe khona.
    m_Metadata:
      m_Items: []
  - m_Id: 63294500818944
    m_Localized: Affiliate
    m_Metadata:
      m_Items: []
  - m_Id: 63661905072128
    m_Localized: I-Affiliate ithetha iqumrhu elilawulayo, elilawulwa okanye liphantsi
      kolawulo olufanayo neqela, apho "ulawulo" luthetha ubunini be-50% okanye ngaphezulu
      kwezabelo, inzala ye-equity okanye ezinye izibambiso ezinelungelo lokuvotela
      unyulo lwabalawuli okanye elinye igunya elilawulayo.
    m_Metadata:
      m_Items: []
  - m_Id: 63872039702528
    m_Localized: Ilizwe
    m_Metadata:
      m_Items: []
  - m_Id: 63910203674624
    m_Localized: 'Ilizwe libhekisa ku: eMzantsi Afrika'
    m_Metadata:
      m_Items: []
  - m_Id: 64172515446784
    m_Localized: Inkampani
    m_Metadata:
      m_Items: []
  - m_Id: 64238563151872
    m_Localized: Inkampani (ebizwa ngokuba "yiNkampani", "Thina", "Thina" okanye
      "Yethu" kwesi siVumelwano) ibhekisa kwiFilar.
    m_Metadata:
      m_Items: []
  - m_Id: 64358486691840
    m_Localized: Isixhobo
    m_Metadata:
      m_Items: []
  - m_Id: 64397112037376
    m_Localized: Isixhobo sithetha nasiphi na isixhobo esinokufikelela kwiNkonzo
      efana nekhompyutha, iselula okanye ithebhulethi yedijithali.
    m_Metadata:
      m_Items: []
  - m_Id: 64548060844032
    m_Localized: Isevisi
    m_Metadata:
      m_Items: []
  - m_Id: 64580189212672
    m_Localized: Isevisi ibhekisa Application.
    m_Metadata:
      m_Items: []
  - m_Id: 77746675699712
    m_Localized: Imigaqo neMiqathango (ekwabizwa ngokuba "yiMiqathango") ithetha
      le Miqathango neMiqathango ebumba isivumelwano sonke phakathi kwakho neNkampani
      malunga nokusetyenziswa kweNkonzo. Esi sivumelwano seMigqaliselo neMiqathango
      senziwe ngoncedo lweMigaqo neMiqathango yoMvelisi.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
