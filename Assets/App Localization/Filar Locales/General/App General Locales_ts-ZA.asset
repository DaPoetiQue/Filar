  m_TableData:
  - m_Id: 17519398912
    m_Localized: Vukorhokeri bya Vutshila 2023 Filar.
    m_Metadata:
      m_Items: []
  - m_Id: 5015233941504
    m_Localized: "Timfanelo tihi na tihi ta nhundzu ya Vutlhari kumbe ya tiindasitiri,
      na timfanelo tin\u2019wana to hlawuleka eka software ti khomiwa hi N\u2019wini
      na/kumbe vaphakeri va yona va tilayisense."
